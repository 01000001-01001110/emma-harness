    "warn":     { "hex": "#6d4300", "ansi16": "yellow" },
    "info":     { "hex": "#0a4f66", "ansi16": "cyan" },
    "accent":   { "hex": "#7a1560", "ansi16": "magenta" },
    "ground":   { "hex": "#cbcfd4", "ansi16": "white" },
    "comment":  { "hex": "#515a64", "ansi16": "black" },
    "keyword":  { "hex": "#5c2382", "ansi16": "magenta" },
    "string":   { "hex": "#17512c", "ansi16": "green" },
