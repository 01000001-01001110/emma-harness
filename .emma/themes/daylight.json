{
  "name": "daylight",
  "about": "For a light terminal. Every foreground here was measured against #fdf6e3 and clears 4:1; the built-in's do not, which is the whole reason this file exists.",
  "roles": {
    "dim":      { "hex": "#5f6d70", "ansi16": "black" },
    "ok":       { "hex": "#4c6b0a", "ansi16": "green" },
    "err":      { "hex": "#b3202b", "ansi16": "red" },
    "warn":     { "hex": "#8a5a00", "ansi16": "yellow" },
    "info":     { "hex": "#00697a", "ansi16": "cyan" },
    "accent":   { "hex": "#a3186b", "ansi16": "magenta" },
    "ground":   { "hex": "#fdf6e3", "ansi16": "white" },
    "comment":  { "hex": "#7a7566", "ansi16": "black" },
    "keyword":  { "hex": "#7b2d8b", "ansi16": "magenta" },
    "string":   { "hex": "#38691f", "ansi16": "green" },
    "number":   { "hex": "#8a4b12", "ansi16": "yellow" },
    "type":     { "hex": "#0e6b6b", "ansi16": "cyan" },
    "function": { "hex": "#1550a8", "ansi16": "blue" }
  },
  "pairs": {
    "chip":      { "fg": "ground", "bg": "accent" },
    "selection": { "fg": "accent", "bg": "#eee8d5" }
  }
}
